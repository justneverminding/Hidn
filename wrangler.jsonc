{
  "name": "hidn",
  "main": "./apps/web/src/worker.ts",
  "compatibility_date": "2026-09-29",
  "vars": {
    "ANONYMOUS_ZK_ENABLED": "true"
  },
  "assets": {
    "binding": "ASSETS",
    "directory": "./apps/web/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/*"]
  },
  "d1_databases": [{
    "binding": "ROOM_DB",
    "database_name": "hidn-room",
    "database_id": "f91ca66e-9e9c-40d7-ae1b-eed375133380",
    "migrations_dir": "./migrations"
  }]
}
